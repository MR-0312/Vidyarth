# Backend environment variables
# Copy this file to .env for local development
# or set these as environment variables on your hosting platform.

# Node environment (development | production)
NODE_ENV=development

# Server port (Render sets this automatically in production)
PORT=8080

# Supabase project URL — found in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase service-role key (keep secret!) — same Settings → API page
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT secret used to sign auth tokens — use a long random string
JWT_SECRET=your-very-long-and-secure-jwt-secret

# Allowed CORS origins (comma-separated)
# Development:  http://localhost:5173
# Production:   https://<your-vercel-app>.vercel.app,https://<your-custom-domain>
CORS_ORIGIN=http://localhost:5173

# GitHub OAuth Configuration
# Get these from: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub OAuth Redirect URI
# Development:  http://localhost:5173/oauth/github/callback
# Production:   https://<your-domain>/oauth/github/callback
GITHUB_REDIRECT_URI=http://localhost:5173/oauth/github/callback

# Frontend URL (used for redirects)
FRONTEND_URL=http://localhost:5173
