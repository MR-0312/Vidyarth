# Frontend environment variables
# Copy this file to .env.local for local development
# or set these as environment variables on your hosting platform.

# Backend API base URL (without trailing slash)
# Development: http://localhost:8080
# Production (Render):  https://<your-render-service>.onrender.com
# Production (Vercel):  leave empty — Vercel rewrites /api/* to the backend
VITE_API_BASE_URL=http://localhost:8080
